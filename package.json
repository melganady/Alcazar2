    "crawl": "node --env-file=.env --import tsx scripts/ingest/discovery-crawl.ts",
    "db:constraints": "node --env-file=.env --import tsx scripts/ingest/apply-constraints.ts",
    "validate:projects": "node --env-file=.env --import tsx scripts/ingest/validate.ts",
