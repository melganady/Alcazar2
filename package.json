    "enrich:dld": "node --env-file=.env --import tsx scripts/ingest/dld-enrich.ts",
    "seed:mortgage": "node --env-file=.env --import tsx scripts/seed-mortgage.ts",
    "check:budgets": "node --import tsx scripts/check-budgets.ts",
    "sourcing:list": "node --env-file=.env --import tsx scripts/ingest/sourcing-list.ts",
    "import:media": "node --env-file=.env --import tsx scripts/ingest/import-media.ts",
