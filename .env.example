# Copy to .env and fill in. The Payload config selects its database and
# storage adapters from these values — no code change between environments.
PAYLOAD_SECRET=generate-a-long-random-string

# postgres:// in production (Neon). Anything else falls back to local SQLite,
# which does NOT persist on Vercel.
DATABASE_URI=file:./alcazar-dev.db

# Canonical URLs, sitemaps, OG image links
NEXT_PUBLIC_SITE_URL=https://alcazar.ae

# Media storage (S3-compatible, e.g. Cloudflare R2). Without a bucket,
# uploads are written to the container filesystem and lost on redeploy.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Lead pipeline (§13) — all optional; console adapters run without them
HUBSPOT_ACCESS_TOKEN=
RESEND_API_KEY=
EMAIL_FROM="Alcázar <hello@alcazar.ae>"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Alcázar CRM (/crm) — comma-separated recipients for the "new lead" staff
# alert, sent via the RESEND_API_KEY adapter above. Without this set, the
# alert just logs to the console (dev-safe, but the team won't be notified).
CRM_ALERT_EMAILS=

# Licensed listings feed (§5 Track B) — comes with the right to display
REELLY_API_KEY=
REELLY_API_BASE=https://api-reelly.up.railway.app/api/v2/clients

# Map view (§6) — activates Mapbox on /projects
NEXT_PUBLIC_MAPBOX_TOKEN=

# Production: exclude fixture data
EXCLUDE_FIXTURES=false
