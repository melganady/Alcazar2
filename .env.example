# Copy to .env and fill in.
# Dev uses the SQLite adapter (file:...). Production uses Neon Postgres —
# swap the adapter in payload.config.ts and set a postgres:// URI.
PAYLOAD_SECRET=generate-a-long-random-string
DATABASE_URI=file:./alcazar-dev.db

# Lead pipeline (§13) — all optional; console adapters run without them
HUBSPOT_ACCESS_TOKEN=
RESEND_API_KEY=
EMAIL_FROM="Alcázar <hello@alcazar.ae>"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Map view (§6) — activates Mapbox on /projects
NEXT_PUBLIC_MAPBOX_TOKEN=

# Production: exclude fixture data
EXCLUDE_FIXTURES=false
